# https://getarcane.app/docs/reference/environment-variables.html

ARCANE_ENCRYPTION_KEY=<REPLACEME>

ARCANE_OIDC_ENABLED=true
ARCANE_OIDC_CLIENT_ID=<REPLACEME>
ARCANE_OIDC_CLIENT_SECRET=<REPLACEME>
ARCANE_OIDC_ISSUER_URL=https://auth.fjellhei.men/oidc
ARCANE_OIDC_SCOPES=openid email profile groups
ARCANE_OIDC_GROUPS_CLAIM=groups
ARCANE_OIDC_ROLE_MAPPINGS='[{"claimValue":"auth_admins","roleId":"role_admin"}]'
ARCANE_OIDC_AUTO_REDIRECT_TO_PROVIDER=true
ARCANE_AUTH_LOCAL_ENABLED=false
