#!/bin/bash

# called every 15 minutes

set -euo pipefail

JOBS_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source "$JOBS_DIR/.env"

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/fjellheimen"

check() {
    local failing="$STATE/$1-failing" label=$2
    shift 2
    if "$@"; then
        if [ -e "$failing" ]; then
            rm "$failing"
            "$JOBS_DIR/notify" "$label is up again."
        fi
    elif [ ! -e "$failing" ]; then
        mkdir -p "$STATE"
        touch "$failing"
        "$JOBS_DIR/notify" "$label is down."
    fi
}

kuma_healthy() {
    case $(docker inspect --format '{{.State.Health.Status}}' uptime-kuma 2> /dev/null) in
        healthy|starting) return 0 ;;
        *) return 1 ;;
    esac
}

check heartbeat "Uptime Kuma on fjellside" curl -fsS -m 10 --retry 3 -o /dev/null "$HEARTBEAT_PUSH_URL"
check uptime-kuma "Uptime Kuma on fjellheimen" kuma_healthy
