#!/bin/bash

# called Friday, 4:00 AM

set -euo pipefail

# load ENV
CURRENT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source $CURRENT_DIR/.env

NOTIFY=$CURRENT_DIR/notify

on_error() {
    $NOTIFY "Backup FAILED (exit $?)."
}
trap on_error ERR

$NOTIFY "Backing up $BACKUP_SOURCE to $BACKUP_DESTINATION."

if [ -z "${BACKUP_EXCLUDES+x}" ]; then
    BACKUP_EXCLUDES=()
fi

EXCLUDE_ARGS=()
for pattern in "${BACKUP_EXCLUDES[@]}"; do
    EXCLUDE_ARGS+=(--exclude "$pattern")
done

sudo borg create --numeric-ids "${EXCLUDE_ARGS[@]}" $BACKUP_DESTINATION::{hostname}-{now} $BACKUP_SOURCE || [ $? -le 1 ]
sudo chown -R $BACKUP_USER:$BACKUP_USER $BACKUP_DESTINATION/

$NOTIFY "Backup finished."
